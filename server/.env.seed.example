# Copy to server/.env.seed (gitignored) to run `npm run db:seed`.
# Values: Supabase dashboard > Project Settings > API Keys.
# The service_role key is the MASTER key: never commit it, never share it,
# never put it in client/ or on Render/Vercel.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: password for all demo logins (default LefaDemo2026!)
SEED_PASSWORD=
